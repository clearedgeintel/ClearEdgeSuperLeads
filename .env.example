# ─────────────────────────────────────────────────────────────
# ClearEdge Outreach Platform — environment variables
# Copy to .env and fill in. NEVER commit real secrets to this file.
# .env is gitignored; .env.example must stay blank placeholders only.
# ─────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────
DATABASE_URL=                      # PostgreSQL connection string (Supabase)
SESSION_SECRET=                    # Random string for session/cookie + token signing
APP_URL=http://localhost:5000      # Public base URL — OAuth callbacks + email tracking links. In prod set to the Railway domain.
INSTANT_SITE_BASE_URL=http://localhost:3000  # ClearEdge Instant Site service (demo-site generation + {{demo_url}} token)
PORT=5000                          # Railway sets this automatically
NODE_ENV=development               # 'production' in prod (the start script sets this)

# ── AI (required) ────────────────────────────────────────────
ANTHROPIC_API_KEY=                 # Anthropic Claude API key

# ── Google (OAuth login + lead discovery + enrichment) ───────
GOOGLE_CLIENT_ID=                  # Google OAuth 2.0 client ID
GOOGLE_CLIENT_SECRET=              # Google OAuth 2.0 client secret
GOOGLE_CUSTOM_SEARCH_API_KEY=      # API key with Custom Search API enabled
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=    # Programmable Search Engine ID
GOOGLE_PLACES_API_KEY=             # Places API (New) — may reuse the Custom Search key

# ── Email infrastructure ─────────────────────────────────────
# Resend is the PRIMARY/production transport. If RESEND_API_KEY is unset,
# the app falls back to Gmail SMTP (dev/local only — breaks at real volume).
RESEND_API_KEY=                       # Resend API key (re_...)
RESEND_FROM_EMAIL=                    # Verified sending address — its domain must pass SPF/DKIM in Resend
RESEND_FROM_NAME=                     # Sender display name (folded into "Name <email>")
RESEND_WEBHOOK_SECRET=                # Svix signing secret (whsec_...) — verifies bounce/spam/open/click webhooks
# Optional: dedicated from-address for transactional mail (invites/system).
# Point at a subdomain whose Resend domain has open/click tracking DISABLED so
# invites aren't tracked. Falls back to RESEND_FROM_EMAIL when unset.
RESEND_TRANSACTIONAL_FROM_EMAIL=
# Gmail fallback (dev only). EMAIL_USER/EMAIL_PASSWORD are accepted as aliases.
GMAIL_USER=
GMAIL_PASSWORD=

# ── LinkedIn (Unipile) ───────────────────────────────────────
UNIPILE_BASE_URL=https://api1.unipile.com:13465
UNIPILE_API_KEY=                   # Single shared key for the Unipile tenant
UNIPILE_ACCOUNT_ID=                # Default LinkedIn account ID (per-workspace override lives in app_config)

# ── Billing (Stripe) ─────────────────────────────────────────
# Billing routes return 503 (code='billing_disabled') until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # Verifies Stripe webhook signatures
STRIPE_SOLO_PRICE_ID=              # Price ID for Solo plan
STRIPE_TEAM_PRICE_ID=              # Price ID for Team plan
STRIPE_AGENCY_PRICE_ID=            # Price ID for Agency plan

# ── CRM ──────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=              # HubSpot private app token

# ── Enrichment (optional — degrade gracefully when unset) ────
APOLLO_API_KEY=                    # Apollo.io organization enrichment
HUNTER_API_KEY=                    # Hunter.io email verification + domain search

# ── Machine-to-machine ───────────────────────────────────────
API_KEY=                           # Shared secret for internal/cron webhook endpoints (apiKeyAuth)

# ── Ops / tuning (optional — sensible defaults in code) ──────
DISABLE_SCHEDULER=                 # Set to 1 to disable in-process cron (e.g. on extra Railway replicas)
LOG_LEVEL=                         # pino level: debug | info | warn | error (default info)
LINKEDIN_SEARCH_LIMIT_HOURLY=
LINKEDIN_DISPATCH_LIMIT_HOURLY=
LINKEDIN_SEARCH_LIMIT_DAILY=
LINKEDIN_DISPATCH_LIMIT_DAILY=
LINKEDIN_CONNECTION_LIMIT_DAILY=
EMAIL_DISPATCH_LIMIT_HOURLY=
EMAIL_DISPATCH_LIMIT_DAILY=
