<style>
  :root {
    --accent: #b91c1c;
    --on-accent: #ffffff;
    --page: #ffffff;
    --header: rgba(255,255,255,0.9);
    --surface: #ffffff;
    --surface-alt: #f8fafc;
    --text: #0f172a;
    --muted: #64748b;
    --border: #e2e8f0;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; background: var(--page); color: var(--text);
    font-family: 'Inter', system-ui, sans-serif; line-height: 1.6;
  }
  h1, h2, h3 { font-family: 'Manrope', system-ui, sans-serif; line-height: 1.15; margin: 0; }
  a { color: inherit; }
  .container { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    padding: .7rem 1.1rem; border-radius: 10px; font-weight: 600; text-decoration: none;
    border: 1px solid transparent; cursor: pointer; transition: transform .15s ease, opacity .15s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .btn-lg { padding: .9rem 1.4rem; font-size: 1.05rem; }
  .btn-accent { background: var(--accent); color: var(--on-accent); }
  .btn-outline { background: transparent; color: var(--text); border-color: var(--border); }

